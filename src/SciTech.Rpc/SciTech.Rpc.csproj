<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SciTech.Rpc is a high-performance, code-first, remote procedure call framework, designed to handle remote procedure calls on all levels.
From internet deployed services over HTTP/2 (based on gRPC), to in-process proxy communication.

This package contains the core SciTech.Rpc implementation and should normally not be added separately.
Use one of the SciTech.Rpc implementation packages: SciTech.Rpc.NetGrpc, SciTech.Rpc.NetGrpc.Client, SciTech.Rpc.Lightweight.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Client\RpcProxyDefinitionsBuilder.cs" />
    <None Include="Client\RpcProxyDefinitionsBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!-- Part of the shared framework on .NET -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>

  <ItemGroup>
    <!-- The analyzer runs on this project and is packed into this package (see AddAnalyzerToPackage). -->
    <ProjectReference Include="..\analyzer\SciTech.Rpc.Analyzer\SciTech.Rpc.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\SciTech.Core\SciTech.Core.csproj" />
  </ItemGroup>

  <Target Name="AddAnalyzerToPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\analyzer\SciTech.Rpc.Analyzer\SciTech.Rpc.Analyzer.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_RpcAnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(_RpcAnalyzerAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
